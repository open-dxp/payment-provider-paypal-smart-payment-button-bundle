{
  "name": "open-dxp/payment-provider-paypal-smart-payment-button-bundle",
  "license": "GPL-3.0+",
  "type": "opendxp-bundle",
  "description": "OpenDXP Payment Provider - Paypal Smart Payment Button",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "open-dxp/opendxp": "^1.0",
    "open-dxp/ecommerce-framework-bundle": "^1.0"
  },
  "require-dev": {
    "open-dxp/test-foundation": "1.x-dev",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "symfony/dotenv": "^7.4",
    "symfony/runtime": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "opendxp": {
      "bundles": [
          "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\OpenDxpPaymentProviderPayPalSmartPaymentButtonBundle"
      ]
    }
  }
}
